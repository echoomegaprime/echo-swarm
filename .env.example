# Copy to .env / echo-swarm.env — never commit real secrets.
DATABASE_URL=postgresql://USER:PASS@127.0.0.1:5432/echo_swarm
__VITE_ADDITIONAL_SERVER_ALLOWED_HOSTS=swarm-app.echo-op.com
ECHO_SWARM_EDITION=private-oauth
VITE_ECHO_SWARM_EDITION=private-oauth

# Local FORGE OpenAI-compatible seat
FORGE_BASE_URL=http://127.0.0.1:11438/v1
FORGE_MODEL=c3po-code:echo-qwen38-abliterated-256k

# Optional TEMPER image node
# TEMPER_BASE_URL=http://127.0.0.1:PORT/v1

# Optional hard gate — when set, clients must send Authorization: Bearer <token>
# SWARM_MCP_TOKEN=

# Loopback-only MAXIMALIST_RECONSTRUCTED Fusion Brain worker
FUSION_WORKER_BASE=http://127.0.0.1:8157

# Exact-release certificate (values are deployment-specific; examples only)
# ECHO_RELEASE_SHA=0000000000000000000000000000000000000000
# ECHO_CERTFORGE_VERIFICATION_URL=https://cert.example/v1/public/verifications/verify_EXAMPLE
# ECHO_BUILDER_SIGNING_KEY_FILE=/run/secrets/echo-swarm-builder-ed25519.pem
# ECHO_COMMANDER_DISPLAY_NAME=Bobby Don McWilliams II
# ECHO_COMMANDER_GITHUB_LOGINS=example-login
