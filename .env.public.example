# Public distributable edition: caller-owned API keys only.
ECHO_SWARM_EDITION=public-api
VITE_ECHO_SWARM_EDITION=public-api

# Public deployments should still require an application access token and rate limiting.
# SWARM_MCP_TOKEN=

# Provider credentials are supplied by each caller through the UI/MCP headers.
# Do not set private provider credentials in this service.

# Local seats are optional and remain server-controlled.
# FORGE_BASE_URL=http://127.0.0.1:11438/v1
# FORGE_MODEL=your-local-model

