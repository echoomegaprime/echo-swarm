# Private authoritative edition: OAuth/session credentials only for remote model seats.
ECHO_SWARM_EDITION=private-oauth
VITE_ECHO_SWARM_EDITION=private-oauth

# Exact certified deployment identity (never use a branch name here).
ECHO_RELEASE_SHA=0000000000000000000000000000000000000000
ECHO_CERTFORGE_VERIFICATION_URL=https://cert.example/v1/public/verifications/verify_EXAMPLE

# AI Builder Ed25519 key stays outside the repository with owner-read permissions.
ECHO_BUILDER_SIGNING_KEY_FILE=/run/secrets/echo-swarm-builder-ed25519.pem
ECHO_BUILDER_NAME=OpenAI Codex / Sol
ECHO_BUILDER_MODEL=GPT-5

# Commander ceremony: GitHub OAuth identity must be explicitly allowlisted.
ECHO_COMMANDER_DISPLAY_NAME=Bobby Don McWilliams II
ECHO_COMMANDER_GITHUB_LOGINS=example-login

# Provider OAuth/session material is resolved at runtime; never commit it.
# XAI_OAUTH_TOKEN=

